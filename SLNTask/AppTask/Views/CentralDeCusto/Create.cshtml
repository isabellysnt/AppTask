@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Nova Central de Custo";
}

<h1 class="mb-4">Cadastrar Nova Central de Custo</h1>

<div class="row">
    <div class="col-md-6">
        <form action="/CentralDeCusto/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="Descricao" class="form-label fw-bold">Descrição</label>
                <input type="text" id="Descricao" name="Descricao" class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="CodigoCusto" class="form-label">Código de Custo</label>
                <input type="text" id="CodigoCusto" name="CodigoCusto" class="form-control" />
            </div>

            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar Central de Custo</button>
                <a href="/CentralDeCusto/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>