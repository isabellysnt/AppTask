@model IEnumerable<AppTask.Models.CentralDeCusto>

@{
    ViewData["Title"] = "Centrais de Custo";
}

<h1 class="mb-4">Lista de Centrais de Custo</h1>

<p>
    <a href="/CentralDeCusto/Create" class="btn btn-success text-white">Nova Central de Custo</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nome Central</th>
            <th>Valor Meta Anual</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NomeCentral</td>
                <td>@item.ValorMetaAnual</td>
                <td>
                    <a href="/CentralDeCusto/Edit/@item.Codigo" class="btn btn-primary btn-sm">Editar</a> |
                    <a href="/CentralDeCusto/Details/@item.Codigo" class="btn btn-info btn-sm text-white">Detalhes</a> |
                    <button type="button"
                            class="btn btn-danger btn-sm text-white"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteModal"
                            data-id="@item.Codigo"
                            data-descricao="@item.NomeCentral">
                        Excluir
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmação de Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Deseja realmente excluir a central de custo: <strong id="itemDescricao"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Sim, Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-id');
                var descricao = button.getAttribute('data-descricao');

                var modalDescricao = deleteModal.querySelector('#itemDescricao');
                var deleteForm = deleteModal.querySelector('#deleteForm');

                modalDescricao.textContent = descricao;
                deleteForm.action = '/CentralDeCusto/Delete/' + id;
            });
        }
    </script>
}