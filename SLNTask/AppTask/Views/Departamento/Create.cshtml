@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Novo Departamento";
}

<h1 class="mb-4">Cadastrar Novo Departamento</h1>

<div class="row">
    <div class="col-md-6">
        <form action="/Departamento/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="Nome" class="form-label fw-bold">Nome do Departamento</label>
                <input type="text" id="Nome" name="Nome" class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="Sigla" class="form-label">Sigla</label>
                <input type="text" id="Sigla" name="Sigla" class="form-control" />
            </div>

            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar Departamento</button>
                <a href="/Departamento/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>