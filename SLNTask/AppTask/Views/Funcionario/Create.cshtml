@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Novo Incidente";
}

<h1 class="mb-4">Cadastrar Novo Incidente</h1>

<div class="row">
    <div class="col-md-6">
        <form action="/Incidente/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="Descricao" class="form-label fw-bold">Descrição</label>
                <input type="text" id="Descricao" name="Descricao" class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="DataOcorrencia" class="form-label">Data de Ocorrência</label>
                <input type="datetime-local" id="DataOcorrencia" name="DataOcorrencia" class="form-control" />
            </div>

            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar Incidente</button>
                <a href="/Incidente/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>